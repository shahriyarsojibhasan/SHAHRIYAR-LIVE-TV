<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background Glow -->
    <item>
        <shape>
            <solid android:color="#1A00B3FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Left Highlight Line -->
    <item android:width="4dp" android:gravity="left">
        <shape>
            <solid android:color="#FF00B3FF" />
            <corners
                android:topLeftRadius="8dp"
                android:bottomLeftRadius="8dp" />
        </shape>
    </item>

    <!-- Overall Stroke -->
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#3300B3FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>