# ========================================
# ১. প্রথমেই সবকিছু ব্লক করে দেওয়া হলো
# ========================================
/*

# ========================================
# ২. শুধু প্রয়োজনীয় ফাইল/ফোল্ডার অ্যালাউ করা হলো
# ========================================
!/index.html
!/worker.js
!/*.m3u
!/assest/
!/manifest.json
!/sw.js
!/wrangler.json
!/package.json
!/.gitignore
!/.workerignore
!/.cfignore

# ========================================
# ৩. ফোল্ডারের ভেতরের বড় ফাইলগুলো স্পেসিফিকভাবে ব্লক
# ========================================
/assest/**/*.exe
/assest/**/*.apk
/assest/**/*.zip
/assest/**/*.tar.gz
/assest/**/*.iso

# গ্লোবাল ব্লক
*.exe
*.zip
*.tar.gz
*.apk
*.iso